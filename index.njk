---
layout: base.njk
permalink: /
title: This is
---
{% for post in collections.posts | reverse %}
  <article>
    <header>
      <h2><a href="{{ post.url | url }}">{{ post.data.title }}</a></h2>
      <time datetime="{{ post.date | dateIso }}">{{ post.date | full_date }}</time>
    </header>
    {{ post.content | safe}}
  </article>
{% endfor %}
